# The acceptance image: build the shipped binary the way a consumer would, then
# drive it from a client that shares nothing with it.
#
# `cargo install --locked` rather than `cargo build` on purpose — that is the
# command `docs/RELEASE.md` puts on the manual list, and it is what a consumer
# runs. If the lockfile does not resolve, this image does not build.

ARG RUST_VERSION=1.89.0
FROM docker.io/library/rust:${RUST_VERSION}-bookworm AS build

WORKDIR /src
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 \
    && rm -rf /var/lib/apt/lists/*
# The wrapper creates this context from an explicit input inventory. Git
# metadata, credentials and unrelated host files never enter the build.
COPY . ./
ENV CARGO_TARGET_DIR=/tmp/fsm-build-target PYTHONDONTWRITEBYTECODE=1

# No `rust-toolchain.toml` is copied: the base image already carries the pinned
# version, and the file would make cargo fetch a second copy of it.
RUN python3 acceptance/suite/evidence.py build /src /usr/local

FROM docker.io/library/debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /usr/local/bin/fsm /usr/local/bin/fsm
COPY --from=build /usr/local/share/fsm-build.json /usr/local/share/fsm-build.json

# The repository's own data — example machines, fixture machines, the case
# files, the decimal generator. Read-only inputs to the scenarios.
WORKDIR /src
COPY --from=build /src /src

ENV FSM_BIN=/usr/local/bin/fsm \
    FSM_REPO=/src \
    FSM_BUILD_RECEIPT=/usr/local/share/fsm-build.json \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

ENTRYPOINT ["python3", "-m", "acceptance.suite.run"]
