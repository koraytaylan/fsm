{
  "format": "fsm.handlers/1",
  "handlers": [
    {
      "effect": "request_approval",
      "argv": ["/usr/local/bin/request-approval", "--expense", "{expense_id}"],
      "timeout_ms": 20000,
      "on_ok": { "event": "" }
    },
    {
      "effect": "escalate_approval",
      "argv": ["/usr/local/bin/escalate-approval", "--expense", "{expense_id}"],
      "timeout_ms": 20000,
      "on_ok": { "event": "escalated", "payload": ["not", "an", "object"] }
    }
  ]
}
