{"id":1,"jsonrpc":"2.0","result":{"capabilities":{"completions":{},"logging":{},"prompts":{"listChanged":false},"resources":{"listChanged":true,"subscribe":true},"tools":{"listChanged":false}},"instructions":"fsm runs deterministic, auditable state machines with either one state tree or multiple orthogonal regions. Specs may include explicit deadlines. Workflow: read fsm://docs/spec → machine_create (dry_run first) → instance_create → instance_send. Consult tagged configuration, enabled_events, and deadlines_pending instead of guessing. Time never advances implicitly: call deadline_poll when due. Decimal values are JSON strings (\"125.50\"), never numbers. Execute pending effects, then acknowledge each with effect_ack. Retry the SAME request_id after a timeout and a NEW one after correcting content. Use simulate for event sequences without recording; it does not poll deadlines. Subscribe to fsm://instance/{id} to be told when an instance advances instead of polling instance_get.","protocolVersion":"2025-06-18","serverInfo":{"name":"fsm","title":"fsm — deterministic state machines for LLM workflows","version":"0.1.0"}}}
{"id":2,"jsonrpc":"2.0","result":{"tools":[{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"Create an immutable, content-addressed machine, or validate without saving (`dry_run: true`). Choose one state tree or orthogonal `regions`; specs may declare typed context/events, transitions, effects, invariants, and explicit `deadlines`. Read `fsm://docs/spec` first. Cross-region transitions are invalid, and one event or deadline poll applies at most one transition. Decimal values are JSON strings (`\"19.99\"`), never numbers. Failures include a spec `path`, repair `hint`, and expression `span` when relevant. Identical specs return the same `machine_id` with `created: false`; running instances retain their definition. Flow: `machine_create(dry_run: true)` → fix → `machine_create` → `instance_create`.","inputSchema":{"additionalProperties":false,"properties":{"dry_run":{"type":"boolean"},"if_exists":{"enum":["return_existing","error"],"type":"string"},"spec":{"type":"object"}},"required":["spec"],"type":"object"},"name":"machine_create","outputSchema":{"additionalProperties":true,"properties":{"created":{"type":"boolean"},"dry_run":{"type":"boolean"},"machine_id":{"type":"string"},"name":{"type":"string"},"summary":{"additionalProperties":true,"properties":{"deadlines":{"type":"number"},"events":{"type":"number"},"initial":{"type":"string"},"regions":{"type":"array"},"states":{"type":"number"},"terminal_states":{"type":"array"},"topology":{"enum":["sequential","parallel"],"type":"string"},"transitions":{"type":"number"}},"required":["topology","regions","states","events","transitions","deadlines","terminal_states"],"type":"object"},"warnings":{"type":"array"}},"required":["machine_id","name","created","dry_run","warnings","summary"],"type":"object"},"title":"Create machine"},{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":true},"description":"When you need stored definitions, list machines by optional name substring; then call machine_get.","inputSchema":{"additionalProperties":false,"properties":{"cursor":{"type":"string"},"limit":{"maximum":200,"minimum":1,"type":"integer"},"name_contains":{"type":"string"}},"required":[],"type":"object"},"name":"machine_list","outputSchema":{"additionalProperties":true,"properties":{"machines":{"items":{"additionalProperties":true,"properties":{"deadlines":{"type":"number"},"defined_seq":{"type":"number"},"events":{"type":"number"},"instances":{"additionalProperties":true,"properties":{"cancelled":{"type":"number"},"completed":{"type":"number"},"running":{"type":"number"}},"required":["running","completed","cancelled"],"type":"object"},"machine_id":{"type":"string"},"name":{"type":"string"},"regions":{"type":"number"},"states":{"type":"number"},"topology":{"enum":["sequential","parallel"],"type":"string"}},"required":["machine_id","name","defined_seq","topology","regions","states","events","deadlines","instances"],"type":"object"},"type":"array"},"next_cursor":{"type":"string"}},"required":["machines"],"type":"object"},"title":"List machines"},{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":true},"description":"When you need one definition, get it by id, unique 12-hex prefix, or unambiguous name.","inputSchema":{"additionalProperties":false,"properties":{"machine":{"type":"string"}},"required":["machine"],"type":"object"},"name":"machine_get","outputSchema":{"additionalProperties":true,"properties":{"machine_id":{"type":"string"},"name":{"type":"string"},"spec":{"type":"object"},"summary":{"additionalProperties":true,"properties":{"deadlines":{"type":"number"},"events":{"type":"number"},"initial":{"type":"string"},"regions":{"type":"array"},"states":{"type":"number"},"terminal_states":{"type":"array"},"topology":{"enum":["sequential","parallel"],"type":"string"},"transitions":{"type":"number"}},"required":["topology","regions","states","events","transitions","deadlines","terminal_states"],"type":"object"}},"required":["machine_id","name","spec","summary"],"type":"object"},"title":"Get machine"},{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":true},"description":"When you need static findings, analyze regional reachability, event completeness, deadline reachability, and shadowing before instance_create.","inputSchema":{"additionalProperties":false,"properties":{"machine":{"type":"string"}},"required":["machine"],"type":"object"},"name":"machine_analyze","outputSchema":{"additionalProperties":true,"properties":{"completeness":{"additionalProperties":true,"properties":{"by_leaf":{"type":"object"}},"required":["by_leaf"],"type":"object"},"done_events":{"type":"array"},"eventless_transitions":{"type":"integer"},"findings":{"type":"array"},"internal_events":{"type":"array"},"machine_id":{"type":"string"},"reachability":{"additionalProperties":true,"properties":{"unenterable":{"items":{"type":"string"},"type":"array"}},"required":["unenterable"],"type":"object"},"shadowing":{"type":"array"},"unhandled_done_events":{"type":"array"}},"required":["machine_id","findings","completeness","reachability","shadowing"],"type":"object"},"title":"Analyse machine"},{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":true},"description":"Render Mermaid or DOT; an instance overlay marks every active regional leaf.","inputSchema":{"additionalProperties":false,"properties":{"format":{"enum":["mermaid","dot"],"type":"string"},"instance":{"type":"string"},"machine":{"type":"string"}},"required":["machine","format"],"type":"object"},"name":"machine_diagram","outputSchema":{"additionalProperties":true,"properties":{"diagram":{"type":"string"},"format":{"type":"string"}},"required":["format","diagram"],"type":"object"},"title":"Draw machine"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"When a definition is ready, create an instance with request_id; then use instance_send and deadline_poll. Decimals are JSON strings; `$` names are reserved.","inputSchema":{"additionalProperties":false,"properties":{"context":{"type":"object"},"machine":{"type":"string"},"request_id":{"type":"string"},"tags":{"items":{"type":"string"},"maxItems":32,"type":"array"}},"required":["machine","request_id"],"type":"object"},"name":"instance_create","outputSchema":{"additionalProperties":true,"properties":{"configuration":{"additionalProperties":true,"properties":{"kind":{"enum":["sequential","parallel"],"type":"string"}},"required":["kind"],"type":"object"},"context":{"type":"object"},"deadlines_pending":{"type":"array"},"effects_pending":{"type":"array"},"enabled_events":{"type":"array"},"instance_id":{"type":"string"},"internal_events":{"type":"array"},"leaf":{"type":"string"},"machine":{"additionalProperties":true,"properties":{"machine_id":{"type":"string"},"name":{"type":"string"}},"required":["machine_id","name"],"type":"object"},"regions":{"type":"object"},"request_id":{"type":"string"},"seq":{"type":"number"},"state":{"type":"string"},"state_format":{"type":"string"},"state_hash":{"type":"string"},"status":{"type":"string"}},"required":["instance_id","machine","status","configuration","seq","context","effects_pending","deadlines_pending","enabled_events","state_hash","state_format"],"type":"object"},"title":"Start instance"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"Deliver one event to a running instance; accepted and rejected events are journaled. `request_id` is idempotent over the request content: after a timeout retry the SAME id and payload for the original outcome with `duplicate: true`; corrected content needs a NEW id. A conflict is `req/request_id_conflict`. Inspect the tagged `configuration` (one leaf or region map), transition, `context`, trace, `deadlines_pending`, `effects_pending`, and `enabled_events`. Execute effects and acknowledge them with `effect_ack`. Deadlines never advance implicitly; call `deadline_poll` when due. Rejections include a repair `hint`. Pass `expect_seq` to detect concurrent advancement.","inputSchema":{"additionalProperties":false,"properties":{"event":{"additionalProperties":true,"properties":{"name":{"type":"string"},"payload":{"type":"object"}},"required":["name"],"type":"object"},"expect_seq":{"maximum":9223372036854775807,"minimum":0,"type":"integer"},"instance_id":{"type":"string"},"request_id":{"type":"string"},"stamp":{"items":{"type":"string"},"maxItems":32,"type":"array"}},"required":["instance_id","event","request_id"],"type":"object"},"name":"instance_send","outputSchema":{"additionalProperties":true,"properties":{"applied":{"type":"boolean"},"configuration":{"additionalProperties":true,"properties":{"kind":{"enum":["sequential","parallel"],"type":"string"}},"required":["kind"],"type":"object"},"context":{"type":"object"},"deadlines_pending":{"type":"array"},"duplicate":{"type":"boolean"},"effects_pending":{"type":"array"},"enabled_events":{"type":"array"},"ignored":{"type":"boolean"},"instance_id":{"type":"string"},"internal_events":{"type":"array"},"leaf":{"type":"string"},"machine":{"additionalProperties":true,"properties":{"machine_id":{"type":"string"},"name":{"type":"string"}},"required":["machine_id","name"],"type":"object"},"monitor_flags":{"type":"array"},"regions":{"type":"object"},"request_id":{"type":"string"},"seq":{"type":"number"},"state":{"type":"string"},"state_format":{"type":"string"},"state_hash":{"type":"string"},"status":{"type":"string"},"trace":{"type":"object"},"transition":{"additionalProperties":true,"properties":{"deadline_idx":{"type":"number"},"entered":{"type":"array"},"exited":{"type":"array"},"from_configuration":{"additionalProperties":true,"properties":{"kind":{"enum":["sequential","parallel"],"type":"string"}},"required":["kind"],"type":"object"},"from_leaf":{"type":"string"},"internal":{"type":"boolean"},"region":{"type":"string"},"source_state":{"type":"string"},"to_configuration":{"additionalProperties":true,"properties":{"kind":{"enum":["sequential","parallel"],"type":"string"}},"required":["kind"],"type":"object"},"to_leaf":{"type":"string"},"transition_idx":{"type":"number"}},"required":["internal","from_configuration","to_configuration","exited","entered"],"type":"object"}},"required":["applied","duplicate","seq","configuration","status","context","effects_pending","deadlines_pending","enabled_events","state_hash","state_format","transition","trace","monitor_flags"],"type":"object"},"title":"Send event"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"Poll one instance with host time; time never advances implicitly. One call journals at most one deadline; a no-op also claims `request_id`. Retry the SAME id after a timeout and use a NEW id later. `expect_seq` detects concurrency. Inspect tagged `configuration`, due flags, and `deadlines_pending`; acknowledge effects with `effect_ack`.","inputSchema":{"additionalProperties":false,"properties":{"expect_seq":{"maximum":9223372036854775807,"minimum":0,"type":"integer"},"instance_id":{"type":"string"},"request_id":{"type":"string"}},"required":["instance_id","request_id"],"type":"object"},"name":"deadline_poll","outputSchema":{"additionalProperties":true,"properties":{"configuration":{"additionalProperties":true,"properties":{"kind":{"enum":["sequential","parallel"],"type":"string"}},"required":["kind"],"type":"object"},"context":{"type":"object"},"deadline":{"type":"string"},"deadline_applied":{"type":"boolean"},"deadline_idx":{"type":"number"},"deadline_not_due":{"type":"boolean"},"deadlines_pending":{"type":"array"},"due_ms":{"type":"string"},"duplicate":{"type":"boolean"},"effects_pending":{"type":"array"},"enabled_events":{"type":"array"},"instance_id":{"type":"string"},"internal_events":{"type":"array"},"leaf":{"type":"string"},"machine":{"additionalProperties":true,"properties":{"machine_id":{"type":"string"},"name":{"type":"string"}},"required":["machine_id","name"],"type":"object"},"monitor_flags":{"type":"array"},"next_deadline":{"type":"string"},"next_deadline_idx":{"type":"number"},"next_due_ms":{"type":"string"},"regions":{"type":"object"},"request_id":{"type":"string"},"seq":{"type":"number"},"state":{"type":"string"},"state_format":{"type":"string"},"state_hash":{"type":"string"},"status":{"type":"string"},"trace":{"type":"object"},"transition":{"additionalProperties":true,"properties":{"deadline_idx":{"type":"number"},"entered":{"type":"array"},"exited":{"type":"array"},"from_configuration":{"additionalProperties":true,"properties":{"kind":{"enum":["sequential","parallel"],"type":"string"}},"required":["kind"],"type":"object"},"from_leaf":{"type":"string"},"internal":{"type":"boolean"},"region":{"type":"string"},"source_state":{"type":"string"},"to_configuration":{"additionalProperties":true,"properties":{"kind":{"enum":["sequential","parallel"],"type":"string"}},"required":["kind"],"type":"object"},"to_leaf":{"type":"string"},"transition_idx":{"type":"number"}},"required":["internal","from_configuration","to_configuration","exited","entered"],"type":"object"}},"required":["deadline_applied","deadline_not_due","instance_id","machine","status","configuration","seq","context","effects_pending","deadlines_pending","enabled_events","state_hash","state_format"],"type":"object"},"title":"Poll deadlines"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"When effects_pending is non-empty, acknowledge each executed effect with request_id, then instance_send a domain event. An ack only clears the pending effect — it never fires a transition, and `outcome: \"failed\"` is no exception: report the failure with an explicit domain event.","inputSchema":{"additionalProperties":false,"properties":{"effect_id":{"type":"string"},"instance_id":{"type":"string"},"outcome":{"enum":["ok","failed"],"type":"string"},"request_id":{"type":"string"},"result":{"type":"object"}},"required":["instance_id","effect_id","outcome","request_id"],"type":"object"},"name":"effect_ack","outputSchema":{"additionalProperties":true,"properties":{"acked":{"type":"boolean"},"duplicate":{"type":"boolean"},"effect_id":{"type":"string"},"effects_pending":{"type":"array"},"instance_id":{"type":"string"},"request_id":{"type":"string"},"seq":{"type":"number"}},"required":["instance_id","effect_id","acked","duplicate","seq","effects_pending"],"type":"object"},"title":"Acknowledge effect"},{"annotations":{"destructiveHint":true,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"When work must stop, cancel an instance with a reason and request_id; further sends fail and pending deadlines are cleared.","inputSchema":{"additionalProperties":false,"properties":{"instance_id":{"type":"string"},"reason":{"type":"string"},"request_id":{"type":"string"}},"required":["instance_id","reason","request_id"],"type":"object"},"name":"instance_cancel","outputSchema":{"additionalProperties":true,"properties":{"configuration":{"additionalProperties":true,"properties":{"kind":{"enum":["sequential","parallel"],"type":"string"}},"required":["kind"],"type":"object"},"context":{"type":"object"},"deadlines_pending":{"type":"array"},"duplicate":{"type":"boolean"},"effects_pending":{"type":"array"},"enabled_events":{"type":"array"},"instance_id":{"type":"string"},"internal_events":{"type":"array"},"leaf":{"type":"string"},"machine":{"additionalProperties":true,"properties":{"machine_id":{"type":"string"},"name":{"type":"string"}},"required":["machine_id","name"],"type":"object"},"regions":{"type":"object"},"request_id":{"type":"string"},"seq":{"type":"number"},"state":{"type":"string"},"state_format":{"type":"string"},"state_hash":{"type":"string"},"status":{"type":"string"}},"required":["instance_id","status","seq","configuration","context","deadlines_pending","state_hash","state_format"],"type":"object"},"title":"Cancel instance"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"When a definition bug must reach instances still running, migrate one onto the corrected definition, which must declare it supersedes the machine the instance is on. Dry-run first with dry_run: true: no request_id, works read-only, reports what would change. Migration reschedules every timer from now — a deadline about to fire starts over.","inputSchema":{"additionalProperties":false,"properties":{"dry_run":{"type":"boolean"},"instance_id":{"type":"string"},"request_id":{"type":"string"},"to_machine":{"type":"string"}},"required":["instance_id","to_machine"],"type":"object"},"name":"instance_migrate","outputSchema":{"additionalProperties":true,"properties":{"configuration":{"additionalProperties":true,"properties":{"kind":{"enum":["sequential","parallel"],"type":"string"}},"required":["kind"],"type":"object"},"configuration_after":{"type":"object"},"configuration_mapped":{"type":"object"},"context":{"type":"object"},"context_changes":{"type":"array"},"deadlines_pending":{"type":"array"},"dropped_history":{"type":"array"},"dropped_slots":{"type":"array"},"dry_run":{"type":"boolean"},"effects_pending":{"type":"array"},"enabled_events":{"type":"array"},"from_machine_id":{"type":"string"},"instance_id":{"type":"string"},"internal_events":{"type":"array"},"leaf":{"type":"string"},"machine":{"additionalProperties":true,"properties":{"machine_id":{"type":"string"},"name":{"type":"string"}},"required":["machine_id","name"],"type":"object"},"migrated":{"type":"boolean"},"refusal":{"type":"object"},"regions":{"type":"object"},"rescheduled_deadlines":{"type":"array"},"retained_effects":{"type":"array"},"seq":{"type":"number"},"state":{"type":"string"},"state_format":{"type":"string"},"state_hash":{"type":"string"},"status":{"type":"string"},"to_machine_id":{"type":"string"},"would_migrate":{"type":"boolean"}},"required":["instance_id","from_machine_id","to_machine_id","dry_run"],"type":"object"},"title":"Migrate instance"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"When an instance is waiting on an invocation slot, create its child with request_id. The executor normally does this unattended; call it when none is running. The child id is derived from the parent and the slot, so a retry is a replay.","inputSchema":{"additionalProperties":false,"properties":{"instance_id":{"type":"string"},"request_id":{"type":"string"},"slot":{"type":"string"}},"required":["instance_id","slot","request_id"],"type":"object"},"name":"invocation_start","outputSchema":{"additionalProperties":true,"properties":{"child_instance_id":{"type":"string"},"child_machine_id":{"type":"string"},"duplicate":{"type":"boolean"},"invoked":{"type":"boolean"},"parent_instance_id":{"type":"string"},"request_id":{"type":"string"},"seq":{"type":"number"},"slot":{"type":"string"},"status":{"type":"string"}},"required":["parent_instance_id","slot","child_instance_id","child_machine_id","request_id"],"type":"object"},"title":"Start child"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"When an invoked child has completed or been cancelled, hand its result to the parent with request_id. Legal only once the child has settled; the result arrives at the parent as $done.invoke.<slot>, which its transition handles.","inputSchema":{"additionalProperties":false,"properties":{"instance_id":{"type":"string"},"request_id":{"type":"string"},"slot":{"type":"string"}},"required":["instance_id","slot","request_id"],"type":"object"},"name":"invocation_return","outputSchema":{"additionalProperties":true,"properties":{"child_instance_id":{"type":"string"},"duplicate":{"type":"boolean"},"outcome":{"type":"string"},"parent_instance_id":{"type":"string"},"request_id":{"type":"string"},"returned":{"type":"boolean"},"seq":{"type":"number"},"slot":{"type":"string"},"status":{"type":"string"}},"required":["parent_instance_id","slot","child_instance_id","outcome","request_id"],"type":"object"},"title":"Return from child"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"When signals_pending is non-empty, deliver each signal with request_id. It reaches exactly one instance, the target's own machine validates the event, and whatever happens is journaled — a signal is fire-and-forget.","inputSchema":{"additionalProperties":false,"properties":{"instance_id":{"type":"string"},"request_id":{"type":"string"},"signal_id":{"type":"string"}},"required":["instance_id","signal_id","request_id"],"type":"object"},"name":"signal_deliver","outputSchema":{"additionalProperties":true,"properties":{"delivered":{"type":"boolean"},"duplicate":{"type":"boolean"},"event":{"type":"string"},"outcome":{"type":"string"},"request_id":{"type":"string"},"sender_instance_id":{"type":"string"},"seq":{"type":"number"},"signal_id":{"type":"string"},"target_instance_id":{"type":"string"}},"required":["sender_instance_id","signal_id","target_instance_id","event","outcome","request_id"],"type":"object"},"title":"Deliver signal"},{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":true},"description":"When you need an instance's tagged configuration, context, deadlines, effects, and enabled_events, get it by id.","inputSchema":{"additionalProperties":false,"properties":{"instance_id":{"type":"string"}},"required":["instance_id"],"type":"object"},"name":"instance_get","outputSchema":{"additionalProperties":true,"properties":{"children":{"type":"array"},"configuration":{"additionalProperties":true,"properties":{"kind":{"enum":["sequential","parallel"],"type":"string"}},"required":["kind"],"type":"object"},"context":{"type":"object"},"created_seq":{"type":"number"},"deadlines_pending":{"type":"array"},"effects_pending":{"type":"array"},"enabled_events":{"type":"array"},"history":{"type":"object"},"instance_id":{"type":"string"},"internal_events":{"type":"array"},"leaf":{"type":"string"},"machine":{"additionalProperties":true,"properties":{"machine_id":{"type":"string"},"name":{"type":"string"}},"required":["machine_id","name"],"type":"object"},"machine_history":{"type":"array"},"parent":{"type":["object","null"]},"regions":{"type":"object"},"seq":{"type":"number"},"state":{"type":"string"},"state_format":{"type":"string"},"state_hash":{"type":"string"},"status":{"type":"string"}},"required":["instance_id","machine","status","configuration","seq","context","history","effects_pending","deadlines_pending","enabled_events","state_hash","state_format"],"type":"object"},"title":"Show instance"},{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":true},"description":"When you need running work, list instances by machine, active state in any region, or status.","inputSchema":{"additionalProperties":false,"properties":{"cursor":{"type":"string"},"limit":{"maximum":200,"minimum":1,"type":"integer"},"machine":{"type":"string"},"parent":{"type":"string"},"roots_only":{"type":"boolean"},"state":{"type":"string"},"status":{"enum":["running","completed","cancelled","all"],"type":"string"},"tag":{"type":"string"}},"required":[],"type":"object"},"name":"instance_list","outputSchema":{"additionalProperties":true,"properties":{"instances":{"items":{"additionalProperties":true,"properties":{"configuration":{"additionalProperties":true,"properties":{"kind":{"enum":["sequential","parallel"],"type":"string"}},"required":["kind"],"type":"object"},"created_seq":{"type":"number"},"instance_id":{"type":"string"},"leaf":{"type":"string"},"machine_name":{"type":"string"},"parent":{"type":"object"},"regions":{"type":"object"},"seq":{"type":"number"},"state":{"type":"string"},"status":{"type":"string"},"tags":{"type":"array"}},"required":["instance_id","configuration","status","machine_name","seq","tags"],"type":"object"},"type":"array"},"next_cursor":{"type":"string"}},"required":["instances"],"type":"object"},"title":"List instances"},{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":true},"description":"When you need the audit trail, page event and deadline records; include_trace recomputes decision traces.","inputSchema":{"additionalProperties":false,"properties":{"from_seq":{"maximum":9223372036854775807,"minimum":0,"type":"integer"},"include_rejected":{"type":"boolean"},"include_trace":{"type":"boolean"},"instance_id":{"type":"string"},"limit":{"maximum":500,"minimum":1,"type":"integer"}},"required":["instance_id"],"type":"object"},"name":"instance_history","outputSchema":{"additionalProperties":true,"properties":{"chain_verified":{"type":"boolean"},"entries":{"items":{"type":"object"},"type":"array"},"instance_id":{"type":"string"},"next_from_seq":{"type":"number"}},"required":["instance_id","entries","chain_verified"],"type":"object"},"title":"Read history"},{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"Ask the user for a declared event's fields, then send it. Use at a human gate when you lack the values: the form comes from the machine's own field types, and the answer is validated and journaled exactly like instance_send. Needs a client advertising elicitation; otherwise use instance_send. A declined ask writes nothing and leaves request_id unclaimed.","inputSchema":{"additionalProperties":false,"properties":{"event":{"type":"string"},"instance_id":{"type":"string"},"message":{"type":"string"},"request_id":{"type":"string"}},"required":["instance_id","event","request_id"],"type":"object"},"name":"instance_elicit","outputSchema":{"additionalProperties":true,"properties":{"action":{"type":"string"},"applied":{"type":"boolean"},"configuration":{"additionalProperties":true,"properties":{"kind":{"enum":["sequential","parallel"],"type":"string"}},"required":["kind"],"type":"object"},"context":{"type":"object"},"deadlines_pending":{"type":"array"},"duplicate":{"type":"boolean"},"effects_pending":{"type":"array"},"enabled_events":{"type":"array"},"event":{"type":"string"},"instance_id":{"type":"string"},"internal_events":{"type":"array"},"leaf":{"type":"string"},"machine":{"additionalProperties":true,"properties":{"machine_id":{"type":"string"},"name":{"type":"string"}},"required":["machine_id","name"],"type":"object"},"monitor_flags":{"type":"array"},"regions":{"type":"object"},"request_id":{"type":"string"},"seq":{"type":"number"},"state":{"type":"string"},"state_format":{"type":"string"},"state_hash":{"type":"string"},"status":{"type":"string"},"trace":{"type":"object"},"transition":{"additionalProperties":true,"properties":{"deadline_idx":{"type":"number"},"entered":{"type":"array"},"exited":{"type":"array"},"from_configuration":{"additionalProperties":true,"properties":{"kind":{"enum":["sequential","parallel"],"type":"string"}},"required":["kind"],"type":"object"},"from_leaf":{"type":"string"},"internal":{"type":"boolean"},"region":{"type":"string"},"source_state":{"type":"string"},"to_configuration":{"additionalProperties":true,"properties":{"kind":{"enum":["sequential","parallel"],"type":"string"}},"required":["kind"],"type":"object"},"to_leaf":{"type":"string"},"transition_idx":{"type":"number"}},"required":["internal","from_configuration","to_configuration","exited","entered"],"type":"object"}},"required":["action","applied","event","instance_id"],"type":"object"},"title":"Ask and send"},{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":true},"description":"When you want a what-if, simulate events without journaling or implicit time advancement; rejections are findings.","inputSchema":{"additionalProperties":false,"properties":{"context":{"type":"object"},"events":{"items":{"additionalProperties":true,"properties":{"name":{"type":"string"},"payload":{"type":"object"}},"required":["name"],"type":"object"},"type":"array"},"machine":{"type":"string"},"on_reject":{"enum":["stop","continue"],"type":"string"},"spec":{"type":"object"}},"required":["events"],"type":"object"},"name":"simulate","outputSchema":{"additionalProperties":true,"properties":{"final":{"additionalProperties":true,"properties":{"configuration":{"additionalProperties":true,"properties":{"kind":{"enum":["sequential","parallel"],"type":"string"}},"required":["kind"],"type":"object"},"context":{"type":"object"},"state":{"type":"string"},"terminal":{"type":"boolean"}},"required":["configuration","context","terminal"],"type":"object"},"initial":{"additionalProperties":true,"properties":{"configuration":{"additionalProperties":true,"properties":{"kind":{"enum":["sequential","parallel"],"type":"string"}},"required":["kind"],"type":"object"},"context":{"type":"object"},"state":{"type":"string"}},"required":["configuration","context"],"type":"object"},"steps":{"items":{"additionalProperties":true,"properties":{"applied":{"type":"boolean"},"args":{"type":"object"},"context":{"type":"object"},"effects":{"type":"array"},"error":{"type":"object"},"event":{"type":"string"},"from_configuration":{"additionalProperties":true,"properties":{"kind":{"enum":["sequential","parallel"],"type":"string"}},"required":["kind"],"type":"object"},"from_leaf":{"type":"string"},"ignored":{"type":"boolean"},"index":{"type":"number"},"microsteps":{"type":"array"},"region":{"type":"string"},"to_configuration":{"additionalProperties":true,"properties":{"kind":{"enum":["sequential","parallel"],"type":"string"}},"required":["kind"],"type":"object"},"to_leaf":{"type":"string"},"trace":{"type":"object"}},"required":["index","event","from_configuration