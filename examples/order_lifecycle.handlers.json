{
  "format": "fsm.handlers/1",
  "handlers": [
    {
      "effect": "request_confirmation",
      "argv": ["/usr/local/bin/notify-supplier", "--quiet"],
      "timeout_ms": 120000,
      "on_ok": { "event": "pick", "payload": {} },
      "on_failed": { "event": "cancel", "payload": {} }
    }
  ]
}
